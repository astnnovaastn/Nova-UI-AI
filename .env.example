# Copy to .env and add your Gemini API key locally.
GEMINI_API_KEY=

# Report writing stays separate from Gemini Live. Default provider: gemini.
NOVA_RESEARCH_PROVIDER=gemini
NOVA_RESEARCH_GEMINI_MODEL=gemini-3.5-flash-lite
NOVA_RESEARCH_OPENAI_API_KEY=
NOVA_RESEARCH_OPENAI_MODEL=gpt-4.1-mini
# Separate provider ledgers share the existing single background model slot.
NOVA_RESEARCH_OPENAI_DAILY_REQUESTS=40
NOVA_RESEARCH_OPENAI_DAILY_TOKENS=400000

# Optional research-only fallback. Keys stay on the backend.
# A dedicated research key takes precedence over the shared GROQ_API_KEY.
NOVA_RESEARCH_GROQ_API_KEY=
GROQ_API_KEY=
NOVA_RESEARCH_GROQ_FALLBACK=1
NOVA_RESEARCH_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
NOVA_RESEARCH_GROQ_COOPERATIVE=0
# Optional private runtime root; blank uses <installation>/state.
NOVA_STATE_DIR=
# Optional per-operation ceiling, using conservative configured USD/1M rates.
# A configured ceiling with unknown prices pauses writing rather than assuming zero.
NOVA_RESEARCH_MAX_COST_USD=
NOVA_RESEARCH_GEMINI_MAX_USD_PER_MILLION=
NOVA_RESEARCH_GROQ_MAX_USD_PER_MILLION=
