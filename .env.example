# Copy to .env and add your Gemini API key locally.
GEMINI_API_KEY=

# Report writing stays separate from Gemini Live. Default provider: gemini.
NOVA_RESEARCH_PROVIDER=gemini
NOVA_RESEARCH_GEMINI_MODEL=gemini-3.5-flash
NOVA_RESEARCH_OPENAI_API_KEY=
NOVA_RESEARCH_OPENAI_MODEL=gpt-4.1-mini
# Separate provider ledgers share the existing single background model slot.
NOVA_RESEARCH_OPENAI_DAILY_REQUESTS=40
NOVA_RESEARCH_OPENAI_DAILY_TOKENS=400000
