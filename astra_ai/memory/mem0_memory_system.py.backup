            ],
            'occupation': [
                r'i work as\s+(?:a\s+)?(.+?)(?:\.|,|$)',
                r'i\'m\s+(?:a\s+)?(.+?)(?:\s+developer|\s+dev)(?:\.|,|$)',
                r'i am\s+(?:a\s+)?(.+?)(?:\s+developer|\s+dev)(?:\.|,|$)',
