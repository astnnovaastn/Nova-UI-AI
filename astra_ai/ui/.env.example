# Astra AI React - Environment Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================
# GEMINI AI API CONFIGURATION
# ============================================
# Get your API key from: https://makersuite.google.com/app/apikey
REACT_APP_GEMINI_API_KEY=

# ============================================
# NEWS API CONFIGURATION
# ============================================
# Get your API key from: https://newsapi.org/
REACT_APP_NEWS_API_KEY=

# ============================================
# WEATHER API CONFIGURATION (Optional)
# ============================================
# Get your API key from: https://openweathermap.org/api
REACT_APP_OPENWEATHER_API_KEY=

# ============================================
# BACKEND SERVER CONFIGURATION
# ============================================
# URL of the Nova AI backend server
REACT_APP_NOVA_API_URL=http://localhost:5000

# ============================================
# APPLICATION ENVIRONMENT
# ============================================
# Options: development, production, test
REACT_APP_ENV=development

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable specific features
REACT_APP_ENABLE_VOICE_RECOGNITION=true
REACT_APP_ENABLE_DRAG_DROP=true
REACT_APP_ENABLE_PERSISTENCE=true

# ============================================
# LOGGING AND DEBUG
# ============================================
# Enable debug mode for additional console logs
REACT_APP_DEBUG_MODE=false

# ============================================
# ANALYTICS (Optional)
# ============================================
# Google Analytics Tracking ID
REACT_APP_GA_TRACKING_ID=

# ============================================
# APPLICATION SETTINGS
# ============================================
# Default chat language
REACT_APP_DEFAULT_LANGUAGE=en

# Auto-start camera on load
REACT_APP_AUTO_START_CAMERA=false

# Number of messages to keep in chat history
REACT_APP_CHAT_HISTORY_LIMIT=100

# Auto-save notes interval (milliseconds)
REACT_APP_AUTOSAVE_INTERVAL=5000