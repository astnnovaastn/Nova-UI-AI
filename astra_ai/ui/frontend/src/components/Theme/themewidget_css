.studio-current small,.studio-creator>div small,.preview-panel p,.studio-help,.studio-widget-editor p{font-size:10px;color:color-mix(in srgb,var(--fg) 62%,transparent)}
.studio-header p,.studio-section-title span,.studio-current>span,.studio-creator>div span,.studio-creator label span{font-size:10px}
.studio-pattern-card,.studio-orb-presets button,.studio-widget-picker button,.studio-widget-editor label>span,.studio-widget-editor label em,.studio-widget-editor button{font-size:10px}
.studio-orb-presets button{min-height:42px;align-items:flex-start}.studio-orb-presets button span{white-space:normal;overflow:visible;text-overflow:clip;line-height:1.25;overflow-wrap:anywhere}
.studio-widget-picker,.studio-editor-nav{scrollbar-width:thin;scrollbar-color:var(--red) color-mix(in srgb,var(--bg) 75%,transparent)}
.studio-widget-picker::-webkit-scrollbar,.studio-editor-nav::-webkit-scrollbar{height:4px}.studio-widget-picker::-webkit-scrollbar-thumb,.studio-editor-nav::-webkit-scrollbar-thumb{background:var(--red)}
@media(max-width:760px){
  .theme-studio-shell{position:fixed!important;inset:0!important;width:100vw!important;height:100dvh!important;max-width:none!important;max-height:none!important;filter:none;background:var(--bg)}
  .theme-studio{border-radius:0;min-height:100%;background:color-mix(in srgb,var(--panel) 96%,var(--bg))}
  .studio-creator{position:sticky;top:0;z-index:30;margin:-2px -2px 12px;padding:10px 12px;box-shadow:0 8px 24px color-mix(in srgb,var(--bg) 82%,transparent)}
  .studio-creator>div{grid-column:1}.studio-creator label{grid-column:2}.studio-creator>div small{line-height:1.35}.studio-creator button{font-size:10px}
  .studio-editor-nav,.studio-widget-picker{box-shadow:inset -18px 0 14px -16px var(--red)}
  .studio-editor-nav>button,.studio-widget-picker button{font-size:10px;min-height:36px}
}
